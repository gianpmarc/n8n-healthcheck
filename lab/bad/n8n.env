# n8n-healthcheck lab — BAD stack. Throwaway demo values, not secrets.
# Used both by docker compose (env_file) and by `n8n_healthcheck --env-file`.

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=lab-postgres-password

EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=lab-redis-password
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

N8N_ENCRYPTION_KEY=lab-demo-encryption-key-not-a-secret

# MISCONFIGURED: pruning off while every successful execution is saved.
# The executions table grows without bound.
EXECUTIONS_DATA_PRUNE=false
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# MISCONFIGURED: no /metrics endpoint, so nothing can be monitored or alerted on.
N8N_METRICS=false
